# Rendered from vmr/packaging/arch/PKGBUILD.in in gvcgo/version-manager.
# Do not edit this file by hand: the vmr release workflow overwrites it.
pkgname=vmr
pkgver=@@VERSION@@
pkgrel=1
pkgdesc="Cross-platform SDK version manager"
arch=('x86_64')
url="https://github.com/gvcgo/version-manager"
license=('unknown')
provides=('vmr')
conflicts=('vmr')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/vmr-x86_64-unknown-linux-gnu.tar.xz")
sha256sums=('@@SHA256:vmr-x86_64-unknown-linux-gnu.tar.xz@@')

package() {
    install -Dm755 "$srcdir/vmr-x86_64-unknown-linux-gnu/vmr" "$pkgdir/usr/bin/vmr"
    install -Dm644 "$srcdir/vmr-x86_64-unknown-linux-gnu/README.md" \
        "$pkgdir/usr/share/doc/vmr/README.md"
}
