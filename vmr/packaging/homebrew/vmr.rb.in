# Rendered from vmr/packaging/homebrew/vmr.rb.in in gvcgo/version-manager.
# Do not edit this file by hand: the vmr release workflow overwrites it.
class Vmr < Formula
  desc "Cross-platform SDK version manager"
  homepage "https://github.com/gvcgo/version-manager"
  version "@@VERSION@@"

  on_macos do
    on_arm do
      url "https://github.com/gvcgo/version-manager/releases/download/v@@VERSION@@/vmr-aarch64-apple-darwin.tar.xz"
      sha256 "@@SHA256:vmr-aarch64-apple-darwin.tar.xz@@"
    end

    on_intel do
      url "https://github.com/gvcgo/version-manager/releases/download/v@@VERSION@@/vmr-x86_64-apple-darwin.tar.xz"
      sha256 "@@SHA256:vmr-x86_64-apple-darwin.tar.xz@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/gvcgo/version-manager/releases/download/v@@VERSION@@/vmr-aarch64-unknown-linux-gnu.tar.xz"
      sha256 "@@SHA256:vmr-aarch64-unknown-linux-gnu.tar.xz@@"
    end

    on_intel do
      url "https://github.com/gvcgo/version-manager/releases/download/v@@VERSION@@/vmr-x86_64-unknown-linux-gnu.tar.xz"
      sha256 "@@SHA256:vmr-x86_64-unknown-linux-gnu.tar.xz@@"
    end
  end

  livecheck do
    url "https://github.com/gvcgo/version-manager/releases/latest"
    regex(%r{/releases/tag/(?:vmr-)?v?(\d+(?:\.\d+)+)"}i)
  end

  def install
    bin.install "vmr"
    doc.install "README.md" if File.exist?("README.md")
  end

  def caveats
    <<~EOS
      vmr installs SDK versions itself; Homebrew only provides the vmr binary.

      Apply version switches to the current shell by adding one line to your shell config:

        zsh   (~/.zshrc):                       eval "$(vmr init zsh)"
        bash  (~/.bashrc):                      eval "$(vmr init bash)"
        fish  (~/.config/fish/config.fish):     vmr init fish | source
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/vmr version")
  end
end
