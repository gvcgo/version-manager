# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
# Rendered from vmr/packaging/macports/Portfile.in in gvcgo/version-manager.
# Do not edit this file by hand: the vmr release workflow overwrites it.

PortSystem          1.0

name                vmr
version             @@VERSION@@
revision            0
categories          devel
platforms           darwin
supported_archs     arm64 x86_64
license             MIT
maintainers         {@gvcgo}
description         Cross-platform SDK version manager
long_description    vmr keeps multiple versions of development tools on one machine \
                    and switches between them. MacPorts installs the vmr executable, \
                    while SDK versions are still installed by vmr itself under ~/.vmr.
homepage            https://github.com/gvcgo/version-manager

if {${build_arch} eq "arm64"} {
    set vmr_arch     aarch64
    set vmr_asset    vmr-aarch64-apple-darwin.tar.xz
    set vmr_sha256   @@SHA256:vmr-aarch64-apple-darwin.tar.xz@@
} else {
    set vmr_arch     x86_64
    set vmr_asset    vmr-x86_64-apple-darwin.tar.xz
    set vmr_sha256   @@SHA256:vmr-x86_64-apple-darwin.tar.xz@@
}

master_sites        https://github.com/gvcgo/version-manager/releases/download/v${version}/
distfiles           ${vmr_asset}
worksrcdir          vmr-${vmr_arch}-apple-darwin

checksums           ${vmr_asset} sha256 ${vmr_sha256}

use_xz              yes
use_configure       no
build {}

destroot {
    xinstall -m 0755 ${worksrcpath}/vmr ${destroot}${prefix}/bin/vmr
    if {[file exists ${worksrcpath}/README.md]} {
        xinstall -d ${destroot}${prefix}/share/doc/${name}
        xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/README.md
    }
}

notes "
vmr installs SDK versions itself under ~/.vmr. Enable shell integration with:
    eval \"\$(vmr init zsh)\"
"
